#!/bin/bash
#SBATCH --job-name=nlcg3d
#SBATCH --account=project_xxxx
#SBATCH --partition=small
#SBATCH --time=72:00:00
#SBATCH --nodes=1
#SBATCH --ntasks=55
#SBATCH --cpus-per-task=1
#SBATCH --mem-per-cpu=5000
#SBATCH --output=%x_%j.out

set -euo pipefail
unset SLURM_MEM_PER_NODE SLURM_MEM_PER_GPU

MODULEPATH=""
for pat in $(cat /appl/modulefiles/.modulepath_init_$(uname -m)); do
    for d in $pat; do [ -d "$d" ] && MODULEPATH="${MODULEPATH:+$MODULEPATH:}$d"; done
done
export MODULEPATH
module --force purge
module load StdEnv
module load gcc/15.2.0
module load openmpi/5.0.10
module load openblas/0.3.30

export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
MODEM="${MODEM:-/projappl/project_xxxx/ModEM/bin/Mod3DMT_MF}"

cd "$SLURM_SUBMIT_DIR"
srun "$MODEM" -I NLCG "$@"
